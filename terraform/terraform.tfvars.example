aws_region    = "us-east-1"
application_name = "deadmanshandle"
config_file_path = "../config.json"
create_ses_identity = true # false if the domain of deployment.senderEmail in config.json is already a verified SES identity in this account and region
manage_dkim_dns_records = true # false if that domain's DNS is not in Route 53 in this account
dmarc_record = "" # e.g. "v=DMARC1; p=none; rua=mailto:dmarc@example.com" to create the domain's DMARC record in Route 53
document_versioning = false # true to version the document bucket; old versions are kept for 30 days
schedule_expression = "cron(0 2 * * ? *)" # 2 AM UTC daily
api_flood_guard = true # close the check-in API in a flood, reopening it once the flood stops
api_guard_check_minutes = 15 # how often to check whether to reopen it; later, dmh api check-interval
# firebase_service_account_file = "../firebase-service-account.json" # the Firebase project's service account key, to push notices to the app

tags = {
  Application = "deadmanshandle"
  ManagedBy   = "terraform"
}
