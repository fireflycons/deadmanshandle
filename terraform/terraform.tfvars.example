aws_region    = "us-east-1"
application_name = "deadmanshandle"
config_file_path = "../config.json"
create_ses_identity = true # false if the domain of deployment.senderEmail in config.json is already a verified SES identity in this account and region
manage_dkim_dns_records = true # false if that domain's DNS is not in Route 53 in this account
schedule_expression = "cron(0 2 * * ? *)" # 2 AM UTC daily

tags = {
  Application = "deadmanshandle"
  ManagedBy   = "terraform"
}
